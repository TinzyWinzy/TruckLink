# Copy to .env.local for dev. Production values live in Vercel env vars.
# Trucki yard backend (Django/DRF). Unset = practice mode with local seeds.
# Local dev: python backend/manage.py runserver (proxied same-origin works too).
VITE_API_URL=http://127.0.0.1:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FACILITY_ID=demo-facility
# Audit chaining is server-owned (server/ audit + relay/Cloud Functions). No
# client-side salt or client audit writes — VITE_AUDIT_SALT / VITE_CLIENT_AUDIT_ENABLED removed.
# Phase 6 control tower: base URL of the PowerSync sync service (server/).
# Unset = surge/ROI/heatmap sections show offline empty states.
VITE_SYNC_API_URL=
# Web Push (SAD §10) — VAPID public key, no Firebase involved. Generate with
# `python backend/manage.py generate_vapid_keys` (or `py_vapid generate --applicationServerKey`)
# and set the private half on the backend as VAPID_PRIVATE_KEY.
# Unset = push toggle hidden; legs still LOGGED server-side.
VITE_VAPID_PUBLIC_KEY=
VITE_POWERSYNC_URL=
VITE_BACKEND_URL=http://localhost:3000
# Test hatch: show demo role tabs on the gate screen even when Firebase is
# configured (or in preview builds). Dev default already shows them in demo
# mode; production stays fail-closed unless this is explicitly set.
# VITE_ALLOW_DEMO=true