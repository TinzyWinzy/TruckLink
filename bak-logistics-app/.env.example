# Copy to .env.local for dev. Production values live in Vercel env vars.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FACILITY_ID=demo-facility
# Audit cutover (SAD §7 G5/G6): false once Cloud Functions own audit; salt must match Functions AUDIT_SALT.
VITE_CLIENT_AUDIT_ENABLED=true
VITE_AUDIT_SALT=pilot-salt-rotate-me
# Phase 6 control tower: base URL of the PowerSync sync service (server/).
# Unset = surge/ROI/heatmap sections show offline empty states.
VITE_SYNC_API_URL=
# Shared pilot key for the sync service (server SYNC_API_KEY). Unset = dev only.
VITE_SYNC_API_KEY=
VITE_POWERSYNC_URL=
VITE_BACKEND_URL=http://localhost:3000
