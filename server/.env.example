# BAK OpShield sync service (Phase 4). Copy to .env for local dev.
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bak_logistics
POWERSYNC_JWT_SECRET=dev-secret-at-least-32-chars-long-xxxx
POWERSYNC_URL=https://sync.powersync.service

# Phase 4 async layer — UNSET = broker-less pilot mode (outbox only, tablets unaffected).
# Set to enable workers + live relay, e.g. amqp://guest:guest@localhost:5672
RABBITMQ_URL=

# Phase: security posture. 16+ chars; required on every write/analytics/token
# endpoint when set. Tablets send it as X-API-Key (VITE_SYNC_API_KEY).
# Unset = OPEN dev mode with a boot warning. Never deploy networked without it.
SYNC_API_KEY=
# Exact allowed web origins, comma-separated. Unset = allow-all (dev only).
CORS_ORIGIN=

# Phase 6 surge thresholds
SURGE_QUEUE_THRESHOLD=15
SURGE_ARRIVALS_THRESHOLD=10

# Escalation SMS (unset = log-only pilot). Prefer Africa's Talking for ZW routes.
SUPERVISOR_PHONE=
MANAGER_PHONE=
BDM_PHONE=
# WhatsApp-first notifications (Meta Cloud API). Recipients in 263... format —
# staff receive on cheap WhatsApp bundles, no SMS airtime needed. Requires one
# approved UTILITY template (draft in src/events/notify.ts) + staff opt-in.
# Unset = SMS fallback above; both unset = log-only pilot.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO_SUPERVISOR=
WHATSAPP_TO_FM=
WHATSAPP_TO_BDM=
WHATSAPP_TEMPLATE_QUARANTINE=quarantine_alert
WHATSAPP_TEMPLATE_LANG=en
AT_API_KEY=
AT_USERNAME=
AT_SENDER=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# WMS bridge (unset = log-only pilot)
WMS_EXPORT_URL=
WMS_EXPORT_TOKEN=

# Audit verification + archival
AUDIT_SALT=pilot-salt-rotate-me
S3_ARCHIVE_URL=

# Firestore relay (replaces Cloud Functions — no Blaze plan).
# Service account needs Cloud Datastore User role on the Firebase project.
# Prefer the file path (key stays out of env); JSON inline is the fallback.
# When live, set VITE_CLIENT_AUDIT_ENABLED=false (relay owns the chain).
FIREBASE_PROJECT_ID=radbit-bak-staging
FIREBASE_SERVICE_ACCOUNT_FILE=../.secrets/radbit-bak-staging-firebase-adminsdk-fbsvc-ec37d98f0a.json
FIREBASE_SERVICE_ACCOUNT_JSON=
